NEON_DATABASE_URL=
NEON_STORAGE_BUCKET=
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENV=sandbox

ADMIN_PASSWORD=
SESSION_SECRET=

# Member mail. Leave both blank in local development and mail is skipped.
# Prefer a sending host that is not the site name, so the site CNAME and Resend
# DNS can live side by side:
#   nike.sportswear.deals          CNAME  your host
#   send.nike.sportswear.deals     records Resend shows (SPF TXT and DKIM CNAME)
RESEND_API_KEY=
EMAIL_FROM=Nike Deals <orders@send.nike.sportswear.deals>
NEXT_PUBLIC_SITE_URL=https://nike.sportswear.deals

# After the app is deployed:
# Stripe webhook: https://nike.sportswear.deals/api/webhooks/stripe
# M-Pesa: MPESA_ENV=production
# MPESA_CALLBACK_URL=https://nike.sportswear.deals/api/webhooks/mpesa
# Database: npm run db:migrate, npm run db:seed once, then npm run db:import
